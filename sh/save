#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "usage: save [--no-push] [message]" >&2
    echo "  リポジトリ全体の変更(git add -A)を commit し、" >&2
    echo "  デフォルトでは続けて git push も行う" >&2
    echo "  message を省略した場合は \"wip: <日時>\" を使う" >&2
    echo "  --no-push: commit だけ行い push はしない" >&2
    exit 1
}

PUSH=true
MESSAGE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --no-push)
            PUSH=false
            shift
            ;;
        --help|-h)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            if [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            else
                usage
            fi
            shift
            ;;
    esac
done

[ $# -eq 0 ] || usage

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: not inside a git repository." >&2
    exit 1
fi

git add -A

if git diff --cached --quiet; then
    echo "error: no staged changes (nothing to commit)." >&2
    exit 1
fi

if [ -z "$MESSAGE" ]; then
    MESSAGE="wip: $(date '+%Y-%m-%d %H:%M')"
fi

git commit -m "$MESSAGE"

if $PUSH; then
    . "$SCRIPT_DIR/git_push.sh"
    if push_current_branch; then
        echo "[PUSHED]"
    else
        echo "warning: commit succeeded but git push failed. push manually later." >&2
        exit 1
    fi
fi
