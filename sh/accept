#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    echo "usage: accept [--no-push] [source_name]" >&2
    echo "  今の問題フォルダの解答(+in.txt/out.txt/tl.txt/samples/)を git commit し、" >&2
    echo "  デフォルトでは続けて git push も行う" >&2
    echo "  --no-push: commit だけ行い push はしない" >&2
    echo "  対象ファイルの自動判定は run/runall と同じ" >&2
    exit 1
}

PUSH=true
SOURCE_ARG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --no-push)
            PUSH=false
            shift
            ;;
        --help|-h)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            if [ -z "$SOURCE_ARG" ]; then
                SOURCE_ARG="$1"
            else
                usage
            fi
            shift
            ;;
    esac
done

[ $# -eq 0 ] || usage

. "$SCRIPT_DIR/resolve_target.sh"

TARGET="$(resolve_target "$SOURCE_ARG")" || exit 1

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: not inside a git repository." >&2
    exit 1
fi

PROBLEM_ID="$(basename "$PWD" | tr '[:lower:]' '[:upper:]' | tr -d '_')"

SAMPLE_PATHS=()
for f in in.txt out.txt tl.txt; do
    [ -f "$f" ] && SAMPLE_PATHS+=("$f")
done
[ -d samples ] && SAMPLE_PATHS+=("samples")

ADD_PATHS=("$TARGET" "${SAMPLE_PATHS[@]}")
git add -- "${ADD_PATHS[@]}"

if git diff --cached --quiet; then
    echo "error: no staged changes (already committed, or nothing to add)." >&2
    exit 1
fi

# 指定パス群の変更が「追加」か「更新」かを判定する(何も変わっていなければ空文字)。
status_word() {
    local paths=("$@")
    [ "${#paths[@]}" -eq 0 ] && return 0

    local has_modified=false has_added=false
    local status path
    while IFS=$'\t' read -r status path; do
        case "$status" in
            A) has_added=true ;;
            M|R*|C*) has_modified=true ;;
        esac
    done < <(git diff --cached --name-status -- "${paths[@]}")

    if $has_modified; then
        echo "更新"
    elif $has_added; then
        echo "追加"
    fi
}

SOLUTION_WORD="$(status_word "$TARGET")"
SAMPLE_WORD="$(status_word "${SAMPLE_PATHS[@]}")"

MSG="# ${PROBLEM_ID}"
if [ -n "$SOLUTION_WORD" ]; then
    MSG="$MSG - 解法を${SOLUTION_WORD}"
fi
if [ -n "$SAMPLE_WORD" ]; then
    MSG="$MSG - サンプルを${SAMPLE_WORD}"
fi

git commit -m "$MSG"

if $PUSH; then
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        PUSH_CMD=(git push)
    else
        # 現在のブランチにまだ upstream が無ければ初回設定込みで push する
        CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
        PUSH_CMD=(git push --set-upstream origin "$CURRENT_BRANCH")
    fi

    if "${PUSH_CMD[@]}"; then
        echo "[PUSHED]"
    else
        echo "warning: commit succeeded but git push failed. push manually later." >&2
        exit 1
    fi
fi
