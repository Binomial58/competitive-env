#!/bin/bash
set -euo pipefail

usage() {
    echo "usage: fetchsample [problem_name]" >&2
    echo "  no args: use current directory name as problem name" >&2
    echo "  takes the most recently downloaded zip in the Windows Downloads folder" >&2
    echo "  (regardless of its name), moves it into the current directory as" >&2
    echo "  <problem_name>.zip, then hands off to unzips" >&2
    exit 1
}

case "${1:-}" in
    --help|-h)
        usage
        ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROBLEM_NAME="${1:-$(basename "$PWD")}"

. "$SCRIPT_DIR/downloads_dir.sh"

DOWNLOADS_DIR="$(resolve_downloads_dir)" || {
    echo "error: could not locate Windows Downloads folder." >&2
    exit 1
}

shopt -s nullglob
candidates=( "$DOWNLOADS_DIR"/*.zip "$DOWNLOADS_DIR"/*.ZIP )
shopt -u nullglob

if [ "${#candidates[@]}" -eq 0 ]; then
    echo "error: no zip files found in $DOWNLOADS_DIR." >&2
    exit 1
fi

latest=""
latest_mtime=-1
for f in "${candidates[@]}"; do
    mtime="$(stat -c %Y "$f" 2>/dev/null || echo -1)"
    if [ "$mtime" -gt "$latest_mtime" ]; then
        latest_mtime="$mtime"
        latest="$f"
    fi
done

mv "$latest" "./$PROBLEM_NAME.zip"
echo "[MV] $latest -> ./$PROBLEM_NAME.zip"

exec "$SCRIPT_DIR/unzips" "./$PROBLEM_NAME.zip"
